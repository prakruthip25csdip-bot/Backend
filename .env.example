# ParkinsonVoice Backend Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=ParkinsonVoice API
APP_VERSION=1.0.0
DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=sqlite:///./parkinson_voice.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql://username:password@localhost:5432/parkinson_voice

# File Storage
UPLOAD_DIR=uploads
MAX_AUDIO_FILE_SIZE_MB=50
ALLOWED_AUDIO_EXTENSIONS=wav,mp3,ogg,flac,m4a,webm

# AI Model
MODEL_PATH=app/ml/models/parkinson_model.pkl
FEATURES_SCALER_PATH=app/ml/models/scaler.pkl

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# Email (optional - for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_EMAIL=noreply@parkinsonvoice.ai
EMAILS_FROM_NAME=ParkinsonVoice

# Admin
FIRST_SUPERUSER_EMAIL=admin@parkinsonvoice.ai
FIRST_SUPERUSER_PASSWORD=admin123!
